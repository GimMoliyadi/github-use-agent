# Mock makes no LLM network calls. GitHub data is still real.
MODEL_MODE=mock
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=45
LLM_MAX_RETRIES=1
# auto probes tool calling + JSON schema, then falls back to validated JSON text.
LLM_OUTPUT_MODE=auto
GITHUB_TOKEN=
DATA_DIR=./data
# Optional per-million-token prices; zero means monetary cost is unknown.
LLM_INPUT_PRICE_PER_MILLION=0
LLM_OUTPUT_PRICE_PER_MILLION=0
# Public deployment should set this to protect paid calls and research history.
APP_ACCESS_TOKEN=

